---
interface Props {
  title?: string;
}
const { title = "Alpha Vision | 智慧感知科技" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>{title}</title>

    <!-- 1. Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- 2. FontAwesome 圖示庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- 3. GSAP 動畫庫（游標需要用到） -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <!-- 4. Google 字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- CSS & CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- JS Libraries -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style is:global>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: #F9F8F7; font-family: 'Inter', sans-serif; overflow-x: hidden; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #eae8e6; }
        ::-webkit-scrollbar-thumb { background: #2c2c2c; border-radius: 4px; }
        
        /* 自定義鼠標 */
        .custom-cursor-ring { position: fixed; top: 0; left: 0; width: 32px; height: 32px; border: 2px solid rgba(255,255,255,0.92); border-radius: 50%; pointer-events: none; z-index: 99999; transform: translate(-50%, -50%); transition: width 0.25s cubic-bezier(0.2,0.9,0.4,1.1), height 0.25s cubic-bezier(0.2,0.9,0.4,1.1), background-color 0.2s, border-color 0.2s; background-color: transparent; will-change: transform; mix-blend-mode: difference; }
        .custom-cursor-ring.hover { width: 56px; height: 56px; background-color: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.6); backdrop-filter: invert(0.05) blur(2px); }
        .custom-cursor-dot { position: fixed; top: 0; left: 0; width: 6px; height: 6px; background-color: rgba(255,255,255,0.92); border-radius: 50%; pointer-events: none; z-index: 100000; transform: translate(-50%, -50%); transition: width 0.2s, height 0.2s; will-change: transform; mix-blend-mode: difference; }
        .custom-cursor-dot.hover { width: 10px; height: 10px; background-color: rgba(255,255,255,0.92); }
        * { cursor: none !important; }
        a, button, .clickable, .nav-link, .product-card, .tech-preview-card { cursor: none !important; }
        
        /* 動畫樣式 */
        .fade-item { opacity: 0; transform: translateY(40px); transition: opacity 0.6s cubic-bezier(0.2,0.9,0.4,1.1), transform 0.6s cubic-bezier(0.2,0.9,0.4,1.1); }
        .fade-item.visible { opacity: 1; transform: translateY(0); }
        .product-card, .tech-preview-card { transition: all 0.4s cubic-bezier(0.2,0.9,0.4,1.1); }
        .product-card:hover, .tech-preview-card:hover { transform: translateY(-8px); box-shadow: 0 20px 30px -15px rgba(0,0,0,0.1); }
        @keyframes bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(10px); } }
        .animate-bounce { animation: bounce 1.5s infinite; }
        
        /* 導航欄特效 */
        .navbar-dark { background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,150,255,0.3); box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
        .language-btn { background: rgba(255,255,255,0.1); backdrop-filter: blur(4px); border: 1px solid rgba(0,150,255,0.4); padding: 6px 12px; border-radius: 30px; font-size: 0.8rem; font-weight: 500; color: white; transition: all 0.3s ease; }
        .language-btn:hover { background: rgba(0,150,255,0.2); border-color: rgba(0,150,255,0.8); box-shadow: 0 0 15px rgba(0,150,255,0.3); }
        .dropdown-menu { transition: all 0.3s ease; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); border: 1px solid rgba(0,150,255,0.3); }
        .group:hover .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        
        /* 霓虹特效與科技字體 */
        .glow-text { text-shadow: 0 0 30px rgba(0, 150, 255, 0.3), 0 0 60px rgba(0, 150, 255, 0.15); }
        .neon-border { border: 1px solid rgba(0,150,255,0.25); box-shadow: 0 0 10px rgba(0,150,255,0.1); transition: all 0.3s ease; }
        .neon-border:hover { border-color: rgba(0,150,255,0.6); box-shadow: 0 0 20px rgba(0,150,255,0.25), 0 0 5px rgba(0,150,255,0.5); }
        .neon-btn { position: relative; overflow: hidden; transition: all 0.3s ease; }
        .neon-btn::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(0,150,255,0.4), transparent); transition: left 0.5s ease; }
        .neon-btn:hover::before { left: 100%; }
        .neon-btn:hover { box-shadow: 0 0 20px rgba(0,150,255,0.4); border-color: rgba(0,150,255,0.8); }
        @keyframes scan { 0% { transform: translateX(-100%); } 100% { transform: translateX(200%); } }
        .scan-line { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(0,150,255,0.15), transparent); animation: scan 4s ease-in-out infinite; pointer-events: none; }
        @keyframes glitch { 0%, 100% { transform: translate(0); opacity: 1; } 5% { transform: translate(-1px, 1px); } 10% { transform: translate(1px, -1px); } 15% { transform: translate(-1px, 0); } 20% { transform: translate(1px, 1px); } }
        .glitch-hover:hover { animation: glitch 0.2s ease; }
        .data-stream { position: absolute; width: 2px; height: 100px; background: linear-gradient(to bottom, transparent, rgba(0,150,255,0.6), transparent); animation: streamFlow 2s linear infinite; }
        @keyframes streamFlow { 0% { transform: translateY(-100%); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(100vh); opacity: 0; } }
        .grid-bg { background-image: linear-gradient(rgba(0,150,255,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(0,150,255,0.08) 1px, transparent 1px); background-size: 40px 40px; }
        .energy-bar { position: relative; overflow: hidden; }
        .energy-bar::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, #00aaff, #00ffcc, #00aaff); animation: energyPulse 2s ease-in-out infinite; }
        @keyframes energyPulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; box-shadow: 0 0 10px #00aaff; } }
        .tech-font { font-family: 'Space Grotesk', monospace; letter-spacing: -0.02em; }
        .content-wrapper { position: relative; z-index: 2; padding-top: 4rem; }
        @media (min-width: 768px) {
            .content-wrapper { padding-top: 4.5rem; }
        }
        .hero-bg { position: absolute; inset: 0; z-index: 0; }
        .noise-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; opacity: 0.03; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"); }
        .logo-img { transition: transform 0.3s ease, filter 0.3s ease; }
        .logo-img:hover { transform: scale(1.05); filter: drop-shadow(0 0 8px rgba(0,150,255,0.5)); }

        /* 流動科技感與人體骨骼動畫 */
        .flowing-line { position: absolute; height: 2px; background: linear-gradient(90deg, transparent, #00aaff, #00ffcc, #00aaff, transparent); animation: flowLine 3s ease-in-out infinite; opacity: 0.6; }
        @keyframes flowLine { 0% { width: 0; opacity: 0; left: 0; } 50% { width: 100%; opacity: 0.8; left: 0; } 100% { width: 0; opacity: 0; left: 100%; } }
        .particle-stream { position: absolute; width: 4px; height: 4px; background: #00aaff; border-radius: 50%; filter: blur(1px); animation: particleFlow 2s linear infinite; }
        @keyframes particleFlow { 0% { transform: translateX(0) translateY(0); opacity: 1; } 100% { transform: translateX(300px) translateY(calc(-30px + 60px * var(--offset))); opacity: 0; } }
        .ring-glow { position: absolute; border-radius: 50%; border: 1px solid rgba(0,170,255,0.3); animation: ringExpand 3s ease-out infinite; }
        @keyframes ringExpand { 0% { width: 20px; height: 20px; opacity: 0.8; transform: translate(-50%, -50%) scale(0.5); } 100% { width: 200px; height: 200px; opacity: 0; transform: translate(-50%, -50%) scale(1.5); } }
        .scan-bar { position: absolute; width: 100%; height: 3px; background: linear-gradient(90deg, transparent, #00aaff, #00ffcc, #00aaff, transparent); animation: scanBarMove 4s ease-in-out infinite; opacity: 0.7; }
        @keyframes scanBarMove { 0% { top: 0; opacity: 0; } 10% { opacity: 0.8; } 90% { opacity: 0.8; } 100% { top: 100%; opacity: 0; } }
        .data-node { position: absolute; width: 8px; height: 8px; background: #00aaff; border-radius: 50%; box-shadow: 0 0 10px #00aaff; animation: nodePulse 2s ease-in-out infinite; }
        @keyframes nodePulse { 0%, 100% { opacity: 0.4; transform: scale(1); } 50% { opacity: 1; transform: scale(1.5); box-shadow: 0 0 20px #00aaff; } }
        .connection-line { position: absolute; height: 1px; background: linear-gradient(90deg, #00aaff, #00ffcc); transform-origin: left center; animation: linePulse 1.5s ease-in-out infinite; }
        @keyframes linePulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.8; } }
        .tech-divider { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 3rem 0; }
        .tech-divider-line { width: 60px; height: 1px; background: linear-gradient(90deg, transparent, #00aaff, #00ffcc, #00aaff, transparent); }
        .tech-divider-dot { width: 8px; height: 8px; background: #00aaff; border-radius: 50%; box-shadow: 0 0 10px #00aaff; animation: dotPulse 1.5s ease-in-out infinite; }
        @keyframes dotPulse { 0%, 100% { opacity: 0.5; transform: scale(1); } 50% { opacity: 1; transform: scale(1.3); } }
        .energy-wave { position: relative; overflow: hidden; }
        .energy-wave::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(0,170,255,0.1), rgba(0,255,204,0.1), transparent); animation: energyWaveMove 2s ease-in-out infinite; pointer-events: none; }
        @keyframes energyWaveMove { 0% { left: -100%; } 100% { left: 100%; } }
        .tech-card-hover { transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1); }
        .tech-card-hover:hover { transform: translateY(-5px); box-shadow: 0 20px 40px -15px rgba(0,170,255,0.2); }
        .flow-border { position: relative; overflow: hidden; }
        .flow-border::before { content: ''; position: absolute; top: -2px; left: -2px; right: -2px; bottom: -2px; background: linear-gradient(45deg, #00aaff, #00ffcc, #00aaff, #00ffcc); background-size: 400% 400%; animation: borderFlow 3s ease infinite; border-radius: inherit; z-index: -1; opacity: 0; transition: opacity 0.3s ease; }
        .flow-border:hover::before { opacity: 0.5; }
        @keyframes borderFlow { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
        
        .skeleton-container { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
        .skeleton-dot { position: absolute; width: 12px; height: 12px; background: #00aaff; border-radius: 50%; box-shadow: 0 0 15px #00aaff; animation: skeletonPulse 1.5s ease-in-out infinite; }
        .skeleton-dot::before { content: ''; position: absolute; top: 50%; left: 50%; width: 30px; height: 30px; background: radial-gradient(circle, rgba(0,170,255,0.4) 0%, transparent 70%); border-radius: 50%; transform: translate(-50%, -50%); }
        @keyframes skeletonPulse { 0%, 100% { opacity: 0.6; transform: scale(1); } 50% { opacity: 1; transform: scale(1.3); box-shadow: 0 0 25px #00aaff; } }
        .skeleton-line { position: absolute; background: linear-gradient(90deg, #00aaff, #00ffcc); transform-origin: left top; animation: lineFlow 2s ease-in-out infinite; }
        @keyframes lineFlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; box-shadow: 0 0 8px #00aaff; } }
        .skeleton-glow { position: absolute; width: 100%; height: 100%; background: radial-gradient(ellipse at center, rgba(0,170,255,0.05) 0%, transparent 70%); animation: glowPulse 3s ease-in-out infinite; }
        @keyframes glowPulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.6; } }
        .skeleton-head { top: 0; left: 50%; transform: translateX(-50%); }
        .skeleton-neck { top: 45px; left: 50%; transform: translateX(-50%); width: 8px; height: 20px; background: linear-gradient(180deg, #00aaff, #00ffcc); border-radius: 4px; animation: neckPulse 2s ease-in-out infinite; }
        @keyframes neckPulse { 0%, 100% { height: 20px; opacity: 0.6; } 50% { height: 24px; opacity: 1; } }
        .skeleton-shoulder-l { top: 70px; left: 30%; transform: translateX(-50%); }
        .skeleton-shoulder-r { top: 70px; left: 70%; transform: translateX(-50%); }
        .skeleton-elbow-l { top: 130px; left: 15%; transform: translateX(-50%); }
        .skeleton-elbow-r { top: 130px; left: 85%; transform: translateX(-50%); }
        .skeleton-wrist-l { top: 190px; left: 5%; transform: translateX(-50%); }
        .skeleton-wrist-r { top: 190px; left: 95%; transform: translateX(-50%); }
        .skeleton-hip { top: 160px; left: 50%; transform: translateX(-50%); }
        .skeleton-knee-l { top: 230px; left: 35%; transform: translateX(-50%); }
        .skeleton-knee-r { top: 230px; left: 65%; transform: translateX(-50%); }
        .skeleton-ankle-l { top: 290px; left: 35%; transform: translateX(-50%); }
        .skeleton-ankle-r { top: 290px; left: 65%; transform: translateX(-50%); }
        .data-ring { position: absolute; border: 1px dashed rgba(0,170,255,0.3); border-radius: 50%; animation: rotateRing 10s linear infinite; }
        @keyframes rotateRing { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="noise-overlay"></div>
    <div class="content-wrapper">
        <slot />
    </div>

    <!-- 自定義鼠標腳本 -->
    <script is:inline>
    (function() {
        const initCursor = () => {
            if (!document.body) return;

            const ring = document.createElement('div');
            ring.className = 'custom-cursor-ring';
            const dot = document.createElement('div');
            dot.className = 'custom-cursor-dot';
            document.body.appendChild(ring);
            document.body.appendChild(dot);

            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;
            let ringX = mouseX;
            let ringY = mouseY;
            let dotX = mouseX;
            let dotY = mouseY;
            let isHovering = false;

            document.addEventListener('mousemove', function(e) {
                mouseX = e.clientX;
                mouseY = e.clientY;
            });

            function animate() {
                ringX += (mouseX - ringX) * 0.15;
                ringY += (mouseY - ringY) * 0.15;
                dotX += (mouseX - dotX) * 0.3;
                dotY += (mouseY - dotY) * 0.3;
                ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
                dot.style.transform = `translate(${dotX}px, ${dotY}px) translate(-50%, -50%)`;
                requestAnimationFrame(animate);
            }

            animate();

            function handleMouseOver(e) {
                const target = e.target;
                if (target && target.closest && target.closest('a, button, .clickable, .nav-link, .product-card, .tech-preview-card')) {
                    if (!isHovering) {
                        isHovering = true;
                        ring.classList.add('hover');
                        dot.classList.add('hover');
                    }
                }
            }

            function handleMouseOut(e) {
                const target = e.target;
                if (target && target.closest && target.closest('a, button, .clickable, .nav-link, .product-card, .tech-preview-card')) {
                    if (isHovering) {
                        isHovering = false;
                        ring.classList.remove('hover');
                        dot.classList.remove('hover');
                    }
                }
            }

            document.body.addEventListener('mouseover', handleMouseOver);
            document.body.addEventListener('mouseout', handleMouseOut);
        };

        if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', initCursor);
        } else {
            initCursor();
        }
    })();
    </script>
</body>
</html>