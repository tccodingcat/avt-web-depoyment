---
import Layout from '../Layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
    <style>
        /* 符號圖標容器 */
        .icon-wrapper {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, rgba(0,150,255,0.1), rgba(0,255,204,0.05));
            border-radius: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem auto;
            border: 1px solid rgba(0,150,255,0.3);
            transition: all 0.3s ease;
        }
        .icon-wrapper:hover {
            transform: scale(1.05);
            border-color: rgba(0,150,255,0.6);
            box-shadow: 0 0 20px rgba(0,150,255,0.2);
        }
        .icon-wrapper i {
            font-size: 2.5rem;
            color: #00aaff;
        }
        
        .stat-number { font-family: 'Playfair Display', serif; font-weight: 500; }
    </style>
<Layout>
    <Navbar />
<!-- Hero 區塊 -->
<section class="relative min-h-[50vh] flex flex-col justify-center items-center text-center px-6 overflow-hidden">
    <div class="hero-bg grid-bg">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
        <div class="data-stream" style="left: 15%; animation-delay: 0s;"></div>
        <div class="data-stream" style="left: 85%; animation-delay: 1.5s;"></div>
        <div class="absolute top-20 left-10 w-32 h-32 border border-cyan-400/20 rounded-full"></div>
        <div class="absolute bottom-40 right-20 w-24 h-24 border border-purple-400/20 rotate-45"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto">
        <div class="fade-item">
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="hero_badge">關於我們</span>
            <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium tracking-tight text-neutral-900 leading-[1.1] mt-6 mb-6 glow-text tech-font">感知智慧 驅動未來</h1>
            <p class="text-neutral-600 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed" data-i18n="hero_subtitle">以先進AI技術守護長者安全，重塑智慧照護的未來</p>
        </div>
    </div>
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce"><div class="w-[2px] h-12 bg-gradient-to-b from-cyan-400 to-transparent mx-auto"></div></div>
</section>

<!-- 公司願景區塊 -->
<section class="py-24 px-6 md:px-12 bg-white/30">
    <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-16 items-center mb-20">
            <div class="fade-item">
                <span class="text-sm font-mono text-neutral-500 tracking-wider" data-i18n="mission_label">我們的使命</span>
                <h2 class="font-serif text-4xl md:text-5xl mt-4 mb-6 text-neutral-900 tech-font" data-i18n="mission_title">重塑長者照護的未來</h2>
                <p class="text-neutral-600 leading-relaxed mb-6" data-i18n="mission_text1">在一個全球老齡化人口急劇增長的時代，我們面臨著確保長者安全與福祉的獨特挑戰。Alpha Vision 運用最先進的人工智慧技術，為長者提供全天候的智慧監護，讓每一位長者都能享有尊嚴、安全的生活。</p>
                <p class="text-neutral-600 leading-relaxed" data-i18n="mission_text2">我們相信，科技不應是冰冷的工具，而應該是溫暖的守護者。通過即時人體行為分析，我們不僅偵測跌倒，更能在危險發生前預測潛在風險，為照護者提供寶貴的預警時間。</p>
            </div>
            <div class="fade-item" style="transition-delay:0.1s">
                <div class="icon-wrapper mx-auto">
                    <i class="fas fa-hand-holding-heart"></i>
                </div>
                <div class="text-center mt-4">
                    <p class="text-sm text-cyan-400/70 font-mono">✦ 科技守護生命 ✦</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 數據統計區塊 -->
<section class="py-20 px-6 md:px-12 bg-white/40">
    <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-4 gap-8">
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm neon-border tech-card-hover"><div class="stat-number text-4xl md:text-5xl font-serif text-neutral-900 mb-2">50+</div><p class="text-neutral-500" data-i18n="stat_clients">企業客戶</p></div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm neon-border tech-card-hover" style="transition-delay:0.1s"><div class="stat-number text-4xl md:text-5xl font-serif text-neutral-900 mb-2">99%</div><p class="text-neutral-500" data-i18n="stat_accuracy">偵測準確率</p></div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm neon-border tech-card-hover" style="transition-delay:0.2s"><div class="stat-number text-4xl md:text-5xl font-serif text-neutral-900 mb-2">24/7</div><p class="text-neutral-500" data-i18n="stat_247">全天候守護</p></div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm neon-border tech-card-hover" style="transition-delay:0.3s"><div class="stat-number text-4xl md:text-5xl font-serif text-neutral-900 mb-2">3x</div><p class="text-neutral-500" data-i18n="stat_efficiency">效率提升</p></div>
        </div>
    </div>
</section>

<!-- 核心技術亮點區塊 -->
<section class="py-24 px-6 md:px-12 bg-white/30">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <div class="fade-item">
                <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="tech_badge">核心技術</span>
                <h2 class="font-serif text-4xl md:text-5xl mt-6 text-neutral-900 tech-font" data-i18n="tech_title">創新驅動的技術基石</h2>
                <p class="text-neutral-500 max-w-2xl mx-auto mt-5" data-i18n="tech_subtitle">以神經形態視覺為核心，重新定義智慧監控</p>
            </div>
        </div>
        <div class="grid md:grid-cols-2 gap-12">
            <div class="fade-item bg-white rounded-2xl p-8 shadow-sm about-card neon-border tech-card-hover flow-border">
                <div class="w-16 h-16 bg-black/5 rounded-full flex items-center justify-center mb-5"><i class="fas fa-brain text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-2xl mb-3" data-i18n="tech1_title">神經形態視覺</h3>
                <p class="text-neutral-600 leading-relaxed" data-i18n="tech1_desc">利用動態視覺感測器的力量，專注於核心資訊而不受色彩和紋理的干擾，實現高效率、低延遲的人體行為分析。</p>
            </div>
            <div class="fade-item bg-white rounded-2xl p-8 shadow-sm about-card neon-border tech-card-hover flow-border" style="transition-delay:0.1s">
                <div class="w-16 h-16 bg-black/5 rounded-full flex items-center justify-center mb-5"><i class="fas fa-shield-alt text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-2xl mb-3" data-i18n="tech2_title">雙模態動態視覺感測器</h3>
                <p class="text-neutral-600 leading-relaxed" data-i18n="tech2_desc">專利技術確保各狀態下的物體偵測，提供高時間解析度與動態範圍，同時從根本上保護用戶隱私。</p>
            </div>
            <div class="fade-item bg-white rounded-2xl p-8 shadow-sm about-card neon-border tech-card-hover flow-border" style="transition-delay:0.2s">
                <div class="w-16 h-16 bg-black/5 rounded-full flex items-center justify-center mb-5"><i class="fas fa-chart-line text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-2xl mb-3" data-i18n="tech3_title">實時行為分析</h3>
                <p class="text-neutral-600 leading-relaxed" data-i18n="tech3_desc">即時追蹤人體骨骼關鍵點，精準識別跌倒、揮手、姿態變化等行為，毫秒級響應，守護每一刻安全。</p>
            </div>
            <div class="fade-item bg-white rounded-2xl p-8 shadow-sm about-card neon-border tech-card-hover flow-border" style="transition-delay:0.3s">
                <div class="w-16 h-16 bg-black/5 rounded-full flex items-center justify-center mb-5"><i class="fas fa-lock text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-2xl mb-3" data-i18n="tech4_title">隱私保護架構</h3>
                <p class="text-neutral-600 leading-relaxed" data-i18n="tech4_desc">僅傳輸合成的人骨骼動畫，不顯示、不錄製任何圖像或視頻，在提供智慧監護的同時，全方位保護用戶隱私。</p>
            </div>
        </div>
    </div>
</section>

<!-- 公司歷程區塊 -->
<section class="py-24 px-6 md:px-12 bg-white/40">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <div class="fade-item">
                <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="journey_badge">發展歷程</span>
                <h2 class="font-serif text-4xl md:text-5xl mt-6 text-neutral-900 tech-font" data-i18n="journey_title">從願景到實踐</h2>
                <p class="text-neutral-500 max-w-2xl mx-auto mt-5" data-i18n="journey_subtitle">每一步都堅定向前，為智慧照護開創新的可能</p>
            </div>
        </div>
        <div class="relative">
            <div class="absolute left-1/2 transform -translate-x-1/2 w-px h-full bg-gradient-to-b from-cyan-400/50 to-transparent hidden md:block"></div>
            <div class="space-y-12">
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div class="fade-item text-right md:text-right">
                        <div class="bg-white rounded-2xl p-6 shadow-sm neon-border inline-block w-full md:w-auto md:min-w-[300px]">
                            <span class="text-sm font-mono text-cyan-500">2023</span>
                            <h3 class="font-serif text-xl mt-2 mb-2" data-i18n="milestone1_title">公司成立</h3>
                            <p class="text-neutral-500 text-sm" data-i18n="milestone1_desc">Alpha Vision Technology Limited 正式成立，致力於 AI 智慧照護領域。</p>
                        </div>
                    </div>
                    <div class="hidden md:block"></div>
                </div>
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div class="hidden md:block"></div>
                    <div class="fade-item text-left md:text-left" style="transition-delay:0.1s">
                        <div class="bg-white rounded-2xl p-6 shadow-sm neon-border inline-block w-full md:w-auto md:min-w-[300px]">
                            <span class="text-sm font-mono text-cyan-500">2024</span>
                            <h3 class="font-serif text-xl mt-2 mb-2" data-i18n="milestone2_title">核心技術突破</h3>
                            <p class="text-neutral-500 text-sm" data-i18n="milestone2_desc">成功研發雙模態動態視覺感測器技術，獲得超過20項發明專利。</p>
                        </div>
                    </div>
                </div>
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div class="fade-item text-right md:text-right" style="transition-delay:0.2s">
                        <div class="bg-white rounded-2xl p-6 shadow-sm neon-border inline-block w-full md:w-auto md:min-w-[300px]">
                            <span class="text-sm font-mono text-cyan-500">2025</span>
                            <h3 class="font-serif text-xl mt-2 mb-2" data-i18n="milestone3_title">產品上市</h3>
                            <p class="text-neutral-500 text-sm" data-i18n="milestone3_desc">智慧Care系統正式推出，服務超過50家企業客戶，守護數千個家庭。</p>
                        </div>
                    </div>
                    <div class="hidden md:block"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 價值觀區塊 -->
<section class="py-24 px-6 md:px-12 bg-white/30">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <div class="fade-item">
                <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="values_badge">我們的價值觀</span>
                <h2 class="font-serif text-4xl md:text-5xl mt-6 text-neutral-900 tech-font" data-i18n="values_title">引領我們前行的信念</h2>
            </div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm about-card neon-border tech-card-hover">
                <div class="icon-wrapper w-20 h-20 mx-auto mb-4"><i class="fas fa-lightbulb text-3xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-3" data-i18n="value1_title">創新驅動</h3>
                <p class="text-neutral-500 text-sm" data-i18n="value1_desc">持續投入研發，以最先進的 AI 技術解決長者照護的實際挑戰。</p>
            </div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm about-card neon-border tech-card-hover" style="transition-delay:0.1s">
                <div class="icon-wrapper w-20 h-20 mx-auto mb-4"><i class="fas fa-heart text-3xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-3" data-i18n="value2_title">以人為本</h3>
                <p class="text-neutral-500 text-sm" data-i18n="value2_desc">尊重隱私、關懷生命，讓科技服務於人類的真正需求。</p>
            </div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm about-card neon-border tech-card-hover" style="transition-delay:0.2s">
                <div class="icon-wrapper w-20 h-20 mx-auto mb-4"><i class="fas fa-globe text-3xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-3" data-i18n="value3_title">全球視野</h3>
                <p class="text-neutral-500 text-sm" data-i18n="value3_desc">立足香港，服務全球，為老齡化社會提供智慧解決方案。</p>
            </div>
        </div>
    </div>
</section>

<!-- 加入我們 CTA 區塊 -->
<section class="py-20 px-6 md:px-12 bg-neutral-900 text-white">
    <div class="max-w-4xl mx-auto text-center">
        <div class="fade-item">
            <h2 class="font-serif text-3xl md:text-4xl mb-4" data-i18n="cta_title">加入我們的使命</h2>
            <p class="text-neutral-300 mb-8" data-i18n="cta_desc">我們正在尋找熱愛創新、勇於挑戰的夥伴，共同塑造智慧照護的未來。</p>
            <a href="/contact" class="inline-block bg-white text-black px-8 py-3 rounded-full text-sm font-semibold hover:bg-neutral-200 transition-all duration-300 clickable neon-btn" data-i18n="cta_btn">與我們聯繫 →</a>
        </div>
    </div>
</section>
    <Footer />
</Layout>

<script type="module" src="/translation/pages/about.js"></script>
<script is:inline>
const fadeObserver = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); fadeObserver.unobserve(e.target); } }), { threshold: 0.2 });
document.querySelectorAll('.fade-item').forEach(el => fadeObserver.observe(el));
if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') { gsap.registerPlugin(ScrollTrigger); gsap.utils.toArray('section').forEach(section => { gsap.fromTo(section.querySelectorAll('.fade-item'), { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.8, stagger: 0.15, scrollTrigger: { trigger: section, start: "top 80%", end: "bottom 20%", toggleActions: "play none none reverse" } }); }); }
const threeCanvas = document.getElementById('three-canvas'); if (threeCanvas && typeof THREE !== 'undefined') { const scene = new THREE.Scene(); const camera = new THREE.PerspectiveCamera(45, threeCanvas.clientWidth / threeCanvas.clientHeight, 0.1, 1000); const renderer = new THREE.WebGLRenderer({ canvas: threeCanvas, alpha: true }); const setSize = () => { const w = threeCanvas.parentElement.clientWidth, h = threeCanvas.parentElement.clientHeight; renderer.setSize(w, h); camera.aspect = w / h; camera.updateProjectionMatrix(); }; setSize(); window.addEventListener('resize', setSize); const particlesGeometry = new THREE.BufferGeometry(); const particlesCount = 800; const posArray = new Float32Array(particlesCount * 3); for (let i = 0; i < particlesCount * 3; i += 3) { posArray[i] = (Math.random() - 0.5) * 20; posArray[i+1] = (Math.random() - 0.5) * 12; posArray[i+2] = (Math.random() - 0.5) * 15 - 5; } particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3)); const particlesMaterial = new THREE.PointsMaterial({ color: 0xccccdd, size: 0.08, transparent: true, opacity: 0.5, blending: THREE.AdditiveBlending }); const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial); scene.add(particlesMesh); camera.position.z = 12; camera.position.y = 1; let time = 0; function animate() { requestAnimationFrame(animate); time += 0.002; particlesMesh.rotation.y = time * 0.2; particlesMesh.rotation.x = Math.sin(time * 0.1) * 0.2; renderer.render(scene, camera); } animate(); }

</script>
