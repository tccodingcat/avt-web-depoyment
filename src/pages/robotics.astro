---
import Layout from '../Layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
    <style>
        /* 圖片容器 - 懸浮放大效果 */
        .img-container {
            overflow: hidden;
            border-radius: 1.5rem;
            box-shadow: 0 15px 35px -15px rgba(0,0,0,0.15);
            transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        .img-container:hover {
            transform: scale(1.03);
            box-shadow: 0 25px 45px -15px rgba(0,0,0,0.25);
        }
        .img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .img-container:hover img {
            transform: scale(1.05);
        }
        
        /* 影片容器 - 懸浮放大效果 */
        .video-container {
            overflow: hidden;
            border-radius: 1.5rem;
            box-shadow: 0 15px 35px -15px rgba(0,0,0,0.15);
            transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            background: #000;
        }
        .video-container:hover {
            transform: scale(1.02);
            box-shadow: 0 25px 45px -15px rgba(0,0,0,0.25);
        }
        .video-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
    </style>
<Layout title="機器人解決方案 | Alpha Vision Technology">
    <Navbar />
<!-- Hero 區塊 -->
<section class="relative min-h-[40vh] flex flex-col justify-center items-center text-center px-6 overflow-hidden">
    <div class="hero-bg grid-bg">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
        <div class="data-stream" style="left: 15%; animation-delay: 0s;"></div>
        <div class="data-stream" style="left: 85%; animation-delay: 1.5s;"></div>
        <div class="absolute top-20 left-10 w-32 h-32 border border-cyan-400/20 rounded-full"></div>
        <div class="absolute bottom-40 right-20 w-24 h-24 border border-purple-400/20 rotate-45"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto">
        <div class="fade-item">
            <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="hero_badge">智能移動 · 自主協作</span>
            <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium tracking-tight text-neutral-900 leading-[1.1] mt-6 mb-6 glow-text tech-font" data-i18n="hero_title">機器人解決方案</h1>
            <p class="text-neutral-600 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed" data-i18n="hero_subtitle">結合先進視覺感知與自主導航技術，實現高效巡檢、物品運送與人機協作</p>
        </div>
    </div>
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce"><div class="w-[2px] h-12 bg-gradient-to-b from-cyan-400 to-transparent mx-auto"></div></div>
</section>

<!-- 三大產品區塊 -->
<section class="py-24 px-6 md:px-12 bg-white/30">
    <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-3 gap-12">
            
            <!-- 產品一：固定式機器人 -->
            <div class="fade-item bg-white rounded-3xl p-6 shadow-sm feature-card neon-border tech-card-hover flow-border">
                <div class="w-20 h-20 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-5"><i class="fas fa-comments text-3xl text-cyan-600"></i></div>
                <h2 class="font-serif text-2xl mb-3 text-center" data-i18n="fixed_title">固定式機器人</h2>
                <p class="text-neutral-600 text-center text-sm mb-4" data-i18n="fixed_desc">以對話、情感陪伴、互動為主，適合教育機構、大學、大專院校。提供智能對話、情感識別與互動體驗。</p>
                <div class="mt-4 flex justify-center gap-2 flex-wrap"><span class="text-xs bg-black/5 px-3 py-1 rounded-full">對話互動</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">情感陪伴</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">教育場景</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">人臉識別</span></div>
                <div class="mt-6 img-container">
                    <img src="/images/robot-fixed.jpg" alt="固定式機器人" onerror="this.src='https://placehold.co/600x400/e9e6e2/8b7355?text=Fixed+Robot'">
                </div>
            </div>
            
            <!-- 產品二：自主導航機器人 -->
            <div class="fade-item bg-white rounded-3xl p-6 shadow-sm feature-card neon-border tech-card-hover flow-border" style="transition-delay:0.1s">
                <div class="w-20 h-20 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-5"><i class="fas fa-route text-3xl text-cyan-600"></i></div>
                <h2 class="font-serif text-2xl mb-3 text-center" data-i18n="auto_title">自主導航機器人</h2>
                <p class="text-neutral-600 text-center text-sm mb-4" data-i18n="auto_desc">配備自動導航功能，SLAM即時定位與動態避障，適用於倉儲物流、醫院配送、巡檢等場景。</p>
                <div class="mt-4 flex justify-center gap-2 flex-wrap"><span class="text-xs bg-black/5 px-3 py-1 rounded-full">SLAM導航</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">動態避障</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">自主充電</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">路徑規劃</span></div>
                <div class="mt-6 img-container">
                    <img src="/images/robot-auto.jpg" alt="自主導航機器人" onerror="this.src='https://placehold.co/600x400/e9e6e2/8b7355?text=Autonomous+Robot'">
                </div>
            </div>
            
            <!-- 產品三：具身機器人（影片 + 照片） -->
            <div class="fade-item bg-white rounded-3xl p-6 shadow-sm feature-card neon-border tech-card-hover flow-border" style="transition-delay:0.2s">
                <div class="w-20 h-20 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-5"><i class="fas fa-robot text-3xl text-cyan-600"></i></div>
                <h2 class="font-serif text-2xl mb-3 text-center" data-i18n="embodied_title">具身機器人</h2>
                <p class="text-neutral-600 text-center text-sm mb-4" data-i18n="embodied_desc">結合人工智能與物理身體，具備感知、思考與行動能力。適用於複雜任務執行、人機協作與智能服務場景。</p>
                <div class="mt-4 flex justify-center gap-2 flex-wrap"><span class="text-xs bg-black/5 px-3 py-1 rounded-full">感知互動</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">自主決策</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">任務執行</span><span class="text-xs bg-black/5 px-3 py-1 rounded-full">人機協作</span></div>
                <div class="mt-6 video-container">
                    <video controls poster="/images/robot-embodied-poster.jpg">
                        <source src="/videos/robot-embodied.mp4" type="video/mp4">
                        您的瀏覽器不支援影片播放。
                    </video>
                </div>
                <div class="mt-4 img-container">
                    <img src="/images/robot-embodied.jpg" alt="具身機器人" onerror="this.src='https://placehold.co/600x400/e9e6e2/8b7355?text=Embodied+Robot'">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 核心技術區塊 -->
<section class="py-24 px-6 md:px-12 bg-white/40">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <div class="fade-item">
                <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="tech_badge">核心技術</span>
                <h2 class="font-serif text-4xl md:text-5xl mt-6 text-neutral-900 tech-font" data-i18n="tech_title">智慧移動核心</h2>
            </div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm feature-card neon-border tech-card-hover flow-border">
                <i class="fas fa-map text-3xl text-cyan-600 mb-3"></i>
                <h3 class="font-serif text-xl mb-2" data-i18n="tech1_title">SLAM即時定位</h3>
                <p class="text-neutral-500 text-sm" data-i18n="tech1_desc">同步定位與地圖構建技術，無需預先設定路徑</p>
            </div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm feature-card neon-border tech-card-hover flow-border" style="transition-delay:0.1s">
                <i class="fas fa-eye text-3xl text-cyan-600 mb-3"></i>
                <h3 class="font-serif text-xl mb-2" data-i18n="tech2_title">視覺感知系統</h3>
                <p class="text-neutral-500 text-sm" data-i18n="tech2_desc">深度相機與AI視覺融合，精準識別環境與物體</p>
            </div>
            <div class="fade-item text-center p-8 bg-white rounded-2xl shadow-sm feature-card neon-border tech-card-hover flow-border" style="transition-delay:0.2s">
                <i class="fas fa-robot text-3xl text-cyan-600 mb-3"></i>
                <h3 class="font-serif text-xl mb-2" data-i18n="tech3_title">自主決策引擎</h3>
                <p class="text-neutral-500 text-sm" data-i18n="tech3_desc">AI驅動的路徑規劃與任務排程系統</p>
            </div>
        </div>
    </div>
</section>

<!-- 應用場景區塊 - 簡化為文字概述（無圖片） -->
<section class="py-24 px-6 md:px-12 bg-white/30">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <div class="fade-item">
                <span class="text-xs font-mono uppercase tracking-wider text-neutral-500 border-b border-cyan-400/50 pb-1" data-i18n="scenes_badge">應用場景</span>
                <h2 class="font-serif text-4xl md:text-5xl mt-6 text-neutral-900 tech-font" data-i18n="scenes_title">多元場景應用</h2>
                <p class="text-neutral-500 max-w-2xl mx-auto mt-5" data-i18n="scenes_subtitle">適用於多種行業的智能機器人解決方案</p>
            </div>
        </div>
        <div class="grid md:grid-cols-4 gap-6">
            <div class="fade-item text-center p-6 bg-white rounded-2xl shadow-sm neon-border tech-card-hover">
                <div class="w-16 h-16 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-school text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-2" data-i18n="scene1_title">教育機構</h3>
                <p class="text-neutral-500 text-sm" data-i18n="scene1_desc">互動教學、校園導覽、學生陪伴</p>
            </div>
            <div class="fade-item text-center p-6 bg-white rounded-2xl shadow-sm neon-border tech-card-hover" style="transition-delay:0.1s">
                <div class="w-16 h-16 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-warehouse text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-2" data-i18n="scene2_title">倉儲物流</h3>
                <p class="text-neutral-500 text-sm" data-i18n="scene2_desc">自動搬運、庫存盤點、貨物分揀</p>
            </div>
            <div class="fade-item text-center p-6 bg-white rounded-2xl shadow-sm neon-border tech-card-hover" style="transition-delay:0.2s">
                <div class="w-16 h-16 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-hospital text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-2" data-i18n="scene3_title">醫療照護</h3>
                <p class="text-neutral-500 text-sm" data-i18n="scene3_desc">藥品配送、病房巡檢、患者陪伴</p>
            </div>
            <div class="fade-item text-center p-6 bg-white rounded-2xl shadow-sm neon-border tech-card-hover" style="transition-delay:0.3s">
                <div class="w-16 h-16 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-store text-2xl text-cyan-600"></i></div>
                <h3 class="font-serif text-xl mb-2" data-i18n="scene4_title">零售服務</h3>
                <p class="text-neutral-500 text-sm" data-i18n="scene4_desc">顧客導覽、商品介紹、庫存管理</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA 區塊 -->
<section class="py-20 px-6 md:px-12 bg-neutral-900 text-white">
    <div class="max-w-4xl mx-auto text-center">
        <div class="fade-item">
            <h2 class="font-serif text-3xl md:text-4xl mb-4" data-i18n="cta_title">讓機器人為您服務</h2>
            <p class="text-neutral-300 mb-8" data-i18n="cta_desc">立即預約演示，了解智慧機器人如何提升您的營運效率</p>
            <a href="/contact" class="inline-block bg-white text-black px-8 py-3 rounded-full text-sm font-semibold hover:bg-neutral-200 transition-all duration-300 clickable neon-btn" data-i18n="cta_btn">預約演示 →</a>
        </div>
    </div>
</section>
<Footer />
</Layout>

<script type="module" src="/translation/pages/robotics.js"></script>
<script is:inline>
const fadeObserver = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); fadeObserver.unobserve(e.target); } }), { threshold: 0.2 });
document.querySelectorAll('.fade-item').forEach(el => fadeObserver.observe(el));
if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') { 
    gsap.registerPlugin(ScrollTrigger); 
    gsap.utils.toArray('section').forEach(section => { 
        gsap.fromTo(section.querySelectorAll('.fade-item'), 
            { opacity: 0, y: 50 }, 
            { opacity: 1, y: 0, duration: 0.8, stagger: 0.15, scrollTrigger: { trigger: section, start: "top 80%", end: "bottom 20%", toggleActions: "play none none reverse" } }
        ); 
    }); 
}

</script>